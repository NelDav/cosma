#!/bin/bash
if [ $(which pkexec) ]; then
	pkexec --disable-internal-agent env DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" DISPLAY="$DISPLAY" HOME="$HOME" QT_STYLE_OVERRIDE="$QT_STYLE_OVERRIDE" QT_QPA_PLATFORMTHEME="$QT_QPA_PLATFORMTHEME" XDG_CURRENT_DESKTOP="$XDG_CURRENT_DESKTOP" WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" QT_QPA_PLATFORM="$QT_QPA_PLATFORM" "/usr/bin/calamares" "-D6" "$@"
else
	/usr/bin/calamares "-D6" "$@"
fi
